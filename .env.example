# Copy to .env.local for local development (node scripts/dev-server.mjs), or set these in the host's
# environment variables for production. Never commit real values.

# osu! OAuth app (osu.ppy.sh/home/account/edit -> OAuth). Callback URL: https://<your-domain>/api/auth/callback
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Optional: fixed callback URL (default https://<host>/api/auth/callback)
OSU_REDIRECT_URI=

# Supabase (online features). Run supabase/migrations first.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Numeric osu! user id of the site owner (admin dashboard)
OWNER_OSU_ID=

# Random string; the daily /api/cron cleanup must send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional TURN relay for live sessions: URLs plus either a fixed login or a coturn shared secret
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
