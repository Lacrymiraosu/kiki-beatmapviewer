{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' data: blob: https: wss:; worker-src 'self' blob:; frame-src 'self' https://accounts.google.com https://docs.google.com https://drive.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/(js|assets|i18n)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/sw\\.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(icon\\.svg|manifest\\.webmanifest)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "s"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "b"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "u"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "live"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "collab"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "project"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "invite"
        }
      ],
      "dest": "/api/og"
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/v1?route=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "index.html"
    }
  }
}
